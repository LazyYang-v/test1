FROM node:20-alpine AS build
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM nginx:1.27-alpine
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx /tmp/nginx /etc/nginx/conf.d /etc/nginx/templates && chown -R 101:101 /var/cache/nginx /var/run /var/log/nginx /tmp/nginx /etc/nginx/conf.d /etc/nginx/templates
COPY apps/web/nginx.conf /etc/nginx/nginx.conf
COPY apps/web/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build --chown=101:101 /web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
